---
/**
 * Página de demostración interna (decisión transversal 4 del plan de la Etapa 1).
 * No se enlaza desde ningún lado y pide no ser indexada. Cada pieza de la etapa le agrega
 * su sección.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import LayerBadge from '../components/learn/LayerBadge.astro';
import ModuleHeader from '../components/learn/ModuleHeader.astro';
import SourceList from '../components/learn/SourceList.astro';
import Callout from '../components/learn/Callout.astro';
import WhatIf from '../components/learn/WhatIf.astro';
import Quiz, { type PreguntaQuiz } from '../components/learn/Quiz';
import TtlProgress from '../components/learn/TtlProgress';
import MarcaCompletado from '../components/learn/MarcaCompletado.astro';
import type { ModuloRecorrido } from '../lib/recorrido';
import { CAPAS, NOMBRE_CAPA } from '../engine/core/capas';
import { obtenerModulos, obtenerTodosLosModulos } from '../lib/modulos';
import Simulation from '../components/sim/Simulation';
import { simularDemo } from '../engine/demo/escenario';
import HeaderFormat from '../components/headers/HeaderFormat';
import { ENCABEZADO_IPV4 } from '../engine/demo/encabezado-ipv4';

// Nombres de las capas del modelo OSI (ISO/IEC 7498-1). Cuando exista el catálogo del motor
// (src/engine/core/capas.ts, pieza 1.2), esta lista se toma de ahí.
const capas = [
  { numero: 1, nombre: 'Física' },
  { numero: 2, nombre: 'Enlace de datos' },
  { numero: 3, nombre: 'Red' },
  { numero: 4, nombre: 'Transporte' },
  { numero: 5, nombre: 'Sesión' },
  { numero: 6, nombre: 'Presentación' },
  { numero: 7, nombre: 'Aplicación' },
];

const semanticos = [
  { token: '--color-fondo', uso: 'Fondo de la página' },
  { token: '--color-superficie', uso: 'Tarjetas, paneles y bloques' },
  { token: '--color-texto', uso: 'Texto principal' },
  { token: '--color-texto-atenuado', uso: 'Texto secundario' },
  { token: '--color-borde', uso: 'Bordes de controles y separadores' },
  { token: '--color-foco', uso: 'Indicador de foco y enlaces' },
  { token: '--color-correcto', uso: 'Respuesta correcta' },
  { token: '--color-incorrecto', uso: 'Respuesta incorrecta' },
  { token: '--color-resaltado-fondo', uso: 'Lo que cambió en el paso actual' },
];

const tamanos = ['xs', 'sm', 'base', 'md', 'lg', 'xl', '2xl'];
const espacios = [1, 2, 3, 4, 5, 6, 7, 8];
const radios = ['chico', 'medio', 'grande', 'pildora'];
const duraciones = ['rapida', 'media', 'lenta'];

// Pieza 1.3: pasar por la colección valida todos los módulos en el build.
const modulos = await obtenerTodosLosModulos();
const visibles = await obtenerModulos();

// Piezas 1.5 y 1.6: la línea de tiempo se calcula en el build y llega como props a la isla.
const timelineDemo = simularDemo();

// Pieza 1.8: preguntas sobre el escenario ficticio de la simulación de demostración. El id
// «demo» no es un módulo real; la pieza 1.9 lo usa para probar el indicador de progreso.
const preguntasDemo: PreguntaQuiz[] = [
  {
    pregunta: '[Ejemplo] En el escenario de demostración, ¿por qué nodo pasa el mensaje de A a C?',
    opciones: ['Por ninguno: va directo', 'Por B', 'Por un cuarto nodo, D'],
    correcta: 1,
    explicacion: 'La topología del escenario es A — B — C: el mensaje va de A a B y de B a C.',
  },
  {
    pregunta: '[Ejemplo] ¿Qué anota B en su registro?',
    opciones: [
      'El mensaje, su origen y su destino',
      'Solo la hora de llegada',
      'Nada: B no tiene registro',
    ],
    correcta: 0,
    explicacion: 'La tabla «Registro de B» tiene las columnas Mensaje, Origen y Destino.',
  },
  {
    pregunta: '[Ejemplo] ¿Qué protocolo real representa el escenario de demostración?',
    opciones: ['Ethernet', 'IPv4', 'Ninguno: es ficticio'],
    correcta: 2,
    explicacion:
      'El escenario se inventó para probar los componentes: no representa ningún protocolo.',
  },
];

// Pieza 1.9: módulos de ejemplo para el indicador TTL (en la Etapa 1 no hay módulos visibles).
// «demo» es el del quiz de arriba: terminarlo suma un salto. Los demás no existen.
const recorridoDemo: ModuloRecorrido[] = [
  { id: 'demo-fisica', titulo: '[Ejemplo] Medios físicos', capa: 1 },
  { id: 'demo-enlace', titulo: '[Ejemplo] Tramas', capa: 2 },
  { id: 'demo', titulo: '[Ejemplo] Quiz de /demo/', capa: 3 },
  { id: 'demo-transporte', titulo: '[Ejemplo] Segmentos', capa: 4 },
  { id: 'demo-aplicacion', titulo: '[Ejemplo] Mensajes', capa: 7 },
];
---

<SiteLayout titulo="Demostración" descripcion="Página interna de desarrollo." noindex>
  <div class="demo">
    <header>
      <h1>Demostración de componentes</h1>
      <p class="atenuado">
        Página interna de desarrollo: muestra los tokens y los componentes compartidos con datos de
        ejemplo. No está enlazada desde el sitio.
      </p>
    </header>

    <section aria-labelledby="tokens">
      <h2 id="tokens">Tokens</h2>

      <h3>Colores por capa OSI</h3>
      <p class="atenuado">
        Cada capa tiene un color de fondo y uno de texto y borde, en tema claro y oscuro. El color
        siempre va acompañado del número y el nombre de la capa.
      </p>
      <ul class="rejilla capas" aria-label="Colores de las capas OSI">
        {capas.map(({ numero, nombre }) => (
          <li class="capa" data-capa={numero}>
            <span class="capa-numero">Capa {numero}</span>
            <strong class="capa-nombre">{nombre}</strong>
            <code class="capa-tokens">
              --capa-{numero}-fondo
              <br />
              --capa-{numero}-borde
            </code>
          </li>
        ))}
      </ul>

      <h3>Colores semánticos</h3>
      <ul class="rejilla" aria-label="Colores semánticos">
        {semanticos.map(({ token, uso }) => (
          <li class="semantico">
            <span class="muestra" style={`background-color: var(${token})`} />
            <span>
              <code>{token}</code>
              <br />
              <span class="atenuado">{uso}</span>
            </span>
          </li>
        ))}
      </ul>

      <h3>Tipografía</h3>
      <ul class="lista" aria-label="Escala de tamaños de texto">
        {tamanos.map((t) => (
          <li style={`font-size: var(--texto-${t})`}>
            <code>--texto-{t}</code> Capa por capa
          </li>
        ))}
      </ul>
      <p class="mono">Monoespaciada para bytes: 01 23 45 67 89 ab cd ef</p>

      <h3>Espaciado</h3>
      <ul class="lista" aria-label="Escala de espaciado">
        {espacios.map((n) => (
          <li class="espacio">
            <code>--espacio-{n}</code>
            <span class="barra" style={`inline-size: var(--espacio-${n})`} />
          </li>
        ))}
      </ul>

      <h3>Radios</h3>
      <ul class="rejilla" aria-label="Radios de borde">
        {radios.map((r) => (
          <li class="radio" style={`border-radius: var(--radio-${r})`}>
            <code>--radio-{r}</code>
          </li>
        ))}
      </ul>

      <h3>Duraciones de animación</h3>
      <p class="atenuado">
        Con movimiento reducido (<code>prefers-reduced-motion: reduce</code>) todas valen 0.
      </p>
      <ul class="lista" aria-label="Duraciones de animación">
        {duraciones.map((d) => (
          <li>
            <code>--duracion-{d}</code>
          </li>
        ))}
      </ul>
    </section>

    <section aria-labelledby="coleccion">
      <h2 id="coleccion">Colección de módulos</h2>
      <p class="atenuado">
        Metadatos de cada módulo, validados por el esquema de la colección. Módulos visibles en el
        índice: <strong data-testid="modulos-visibles">{visibles.length}</strong> de{' '}
        {modulos.length}.
      </p>
      <ul class="lista" aria-label="Módulos de la colección">
        {modulos.map(({ id, data }) => (
          <li class="modulo" data-capa={data.capas[0]}>
            <strong>{data.titulo}</strong>
            {data.oculto && <span class="atenuado"> (oculto)</span>}
            <p>{data.descripcion}</p>
            <dl>
              <dt>Id</dt>
              <dd>
                <code>{id}</code>
              </dd>
              <dt>Bloque</dt>
              <dd>{data.bloque}</dd>
              <dt>Orden</dt>
              <dd>{data.orden}</dd>
              <dt>Capas</dt>
              <dd>{data.capas.map((c) => `${c} · ${NOMBRE_CAPA[c]}`).join(', ')}</dd>
              <dt>Lectura</dt>
              <dd>{data.minutos} min</dd>
              <dt>Prerrequisitos</dt>
              <dd>
                {data.prerrequisitos.length > 0
                  ? data.prerrequisitos.map((p) => p.id).join(', ')
                  : 'Ninguno'}
              </dd>
              <dt>Quiz</dt>
              <dd>{data.quiz.length} preguntas</dd>
              <dt>Fuentes</dt>
              <dd>{data.fuentes.map((f) => f.id).join(', ')}</dd>
            </dl>
          </li>
        ))}
      </ul>
    </section>
    <section aria-labelledby="simulacion">
      <h2 id="simulacion">Simulación</h2>
      <p class="atenuado">
        Escenario ficticio de tres nodos (A, B y C): no representa ningún protocolo real. Sirve para
        probar los controles de paso, el diagrama de la topología con el paquete y la tabla de
        estado. En el último paso el paquete lleva el nombre de su PDU, tamaños y una cola, todos
        inventados («[Ejemplo]»).
      </p>
      <Simulation
        client:visible
        timeline={timelineDemo}
        titulo="Simulación de demostración"
        vistas={['topologia', 'tablas']}
      />
    </section>

    <section aria-labelledby="formato">
      <h2 id="formato">Formato</h2>
      <p class="atenuado">
        Encabezado IPv4 de 20 bytes según RFC 791 §3.1, sin opciones. Las direcciones son de
        documentación (RFC 5737) y el checksum lo calcula el motor.
      </p>
      <HeaderFormat client:visible encabezado={ENCABEZADO_IPV4} />
    </section>

    <section aria-labelledby="callout">
      <h2 id="callout">Callout</h2>
      <p class="atenuado">
        Recuadros sin JavaScript. Cada variante se reconoce por su título en texto, además del color
        y el ícono.
      </p>
      <div class="lista" data-testid="demo-callouts">
        <Callout variante="resumen">
          <ul>
            <li>[Ejemplo] Un punto para repasar.</li>
            <li>[Ejemplo] Otro punto para repasar.</li>
          </ul>
        </Callout>
        <Callout variante="nota">
          <p>[Ejemplo] Un comentario al margen del tema principal.</p>
        </Callout>
        <Callout variante="simplificacion">
          <p>[Ejemplo] Qué deja afuera la simulación respecto del estándar.</p>
        </Callout>
        <Callout variante="advertencia">
          <p>[Ejemplo] Un error común que conviene evitar.</p>
        </Callout>
        <Callout variante="nota" titulo="Título propio">
          <p>[Ejemplo] Una nota con un título distinto del de su variante.</p>
        </Callout>
      </div>
    </section>

    <section aria-labelledby="que-pasa-si">
      <h2 id="que-pasa-si">Qué pasa si</h2>
      <p class="atenuado">
        Bloques «¿Qué pasa si…?» sobre el escenario ficticio de la simulación: uno solo con la
        explicación y otro con su propia simulación.
      </p>
      <WhatIf pregunta="[Ejemplo] ¿Qué pasa si B no está?">
        <p>
          En el escenario de demostración, A y C solo se conectan a través de B: sin B, el mensaje
          no tiene por dónde llegar.
        </p>
      </WhatIf>
      <WhatIf
        pregunta="[Ejemplo] ¿Qué pasa si se sigue el mensaje hasta C?"
        timeline={timelineDemo}
        tituloSimulacion="Simulación del caso: el mensaje llega a C"
      >
        <p>El mensaje pasa por B, que lo anota en su registro, y llega a C.</p>
      </WhatIf>
    </section>

    <section aria-labelledby="quiz">
      <h2 id="quiz">Quiz</h2>
      <p class="atenuado">
        Quiz de ejemplo sobre el escenario ficticio. Al terminarlo se guarda el resultado del módulo
        «demo» en este navegador.
      </p>
      <Quiz client:visible moduloId="demo" preguntas={preguntasDemo} />
    </section>

    <section aria-labelledby="indicador-ttl">
      <h2 id="indicador-ttl">Indicador TTL</h2>
      <p class="atenuado">
        Recorrido con cinco módulos de ejemplo. Solo «[Ejemplo] Quiz de /demo/» existe: terminar el
        quiz de arriba suma un salto, sin recargar. El encabezado de esta página cuenta los módulos
        visibles reales, que en la Etapa 1 son ninguno.
      </p>
      <div class="muestra-componente" data-testid="demo-ttl">
        <TtlProgress client:visible modulos={recorridoDemo} conReinicio />
      </div>

      <h3>Índice de ejemplo</h3>
      <p class="atenuado">Como en el inicio, cada módulo completado lleva su marca.</p>
      <ul class="lista" data-testid="demo-ttl-indice">
        {recorridoDemo.map(({ id, titulo, capa }) => (
          <li class="fila">
            <LayerBadge capa={capa} compacta />
            <span>{titulo}</span>
            <MarcaCompletado id={id} />
          </li>
        ))}
      </ul>

      <h3>Sin módulos</h3>
      <div class="muestra-componente" data-testid="demo-ttl-vacio">
        <TtlProgress modulos={[]} />
      </div>
    </section>

    <section aria-labelledby="layout">
      <h2 id="layout">Layout del sitio</h2>
      <p class="atenuado">
        Marcas de capa y encabezado de módulo, con datos de ejemplo. El color de la capa siempre va
        con su número y su nombre.
      </p>

      <h3>Marcas de capa</h3>
      <ul class="fila" aria-label="Marcas de capa">
        {CAPAS.map((capa) => (
          <li>
            <LayerBadge capa={capa} />
          </li>
        ))}
      </ul>
      <p class="atenuado">Versión compacta (el nombre queda para lectores de pantalla):</p>
      <ul class="fila" aria-label="Marcas de capa compactas">
        {CAPAS.map((capa) => (
          <li>
            <LayerBadge capa={capa} compacta />
          </li>
        ))}
      </ul>

      <h3>Encabezado de módulo</h3>
      <div class="muestra-componente" data-testid="demo-encabezado">
        <ModuleHeader
          titulo="[Ejemplo] Un módulo con varias capas"
          descripcion="Encabezado armado con datos de ejemplo para ver todas sus partes."
          capas={[4, 3]}
          minutos={15}
          nivel={4}
          prerrequisitos={[
            { titulo: '[Ejemplo] Módulo previo', href: `${import.meta.env.BASE_URL}demo/#layout` },
          ]}
        />
      </div>

      <h3>Fuentes</h3>
      <div class="muestra-componente">
        <SourceList
          fuentes={[
            {
              tipo: 'rfc',
              id: 'RFC 1071',
              titulo: 'Computing the Internet Checksum',
              seccion: '§1',
              url: 'https://www.rfc-editor.org/rfc/rfc1071',
            },
          ]}
        />
      </div>
    </section>
  </div>
</SiteLayout>

<style>
  .demo {
    max-inline-size: var(--ancho-amplio);
    margin-inline: auto;
    padding: var(--margen-pagina);
    display: grid;
    gap: var(--espacio-6);
  }

  header,
  section {
    display: grid;
    gap: var(--espacio-4);
  }

  h3 {
    margin-block-start: var(--espacio-4);
  }

  .atenuado {
    color: var(--color-texto-atenuado);
  }

  ul {
    list-style: none;
    padding: 0;
  }

  .rejilla {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, var(--ancho-columna-min)), 1fr));
    gap: var(--espacio-3);
  }

  .lista {
    display: grid;
    gap: var(--espacio-2);
  }

  .capa {
    display: grid;
    gap: var(--espacio-1);
    padding: var(--espacio-3) var(--espacio-4);
    background-color: var(--capa-fondo);
    border: var(--borde-fino) solid var(--capa-borde);
    border-inline-start-width: var(--borde-capa);
    border-radius: var(--radio-medio);
  }

  .capa-numero {
    color: var(--capa-borde);
    font-size: var(--texto-sm);
    font-weight: var(--peso-negrita);
  }

  .capa-nombre {
    font-size: var(--texto-md);
  }

  .capa-tokens {
    color: var(--color-texto-atenuado);
    font-size: var(--texto-xs);
  }

  .semantico {
    display: flex;
    align-items: center;
    gap: var(--espacio-3);
    padding: var(--espacio-3);
    background-color: var(--color-superficie);
    border-radius: var(--radio-medio);
  }

  .muestra {
    flex: none;
    inline-size: var(--espacio-7);
    block-size: var(--espacio-7);
    border: var(--borde-fino) solid var(--color-borde);
    border-radius: var(--radio-chico);
  }

  .mono {
    font-family: var(--fuente-mono);
    line-height: var(--altura-linea-mono);
  }

  .espacio {
    display: flex;
    align-items: center;
    gap: var(--espacio-3);
  }

  .espacio code {
    min-inline-size: var(--espacio-8);
  }

  .barra {
    block-size: var(--espacio-3);
    background-color: var(--color-foco);
  }

  .modulo {
    display: grid;
    gap: var(--espacio-2);
    padding: var(--espacio-3) var(--espacio-4);
    background-color: var(--color-superficie);
    border-inline-start: var(--borde-capa) solid var(--capa-borde);
    border-radius: var(--radio-medio);
  }

  .modulo dl {
    display: grid;
    grid-template-columns: max-content 1fr;
    gap: var(--espacio-1) var(--espacio-3);
  }

  .modulo dt {
    color: var(--color-texto-atenuado);
  }

  .modulo dd {
    margin: 0;
  }

  .fila {
    display: flex;
    flex-wrap: wrap;
    gap: var(--espacio-2);
  }

  .muestra-componente {
    padding: var(--espacio-4);
    border: var(--borde-fino) dashed var(--color-borde);
    border-radius: var(--radio-medio);
  }

  .radio {
    padding: var(--espacio-4);
    background-color: var(--color-superficie);
    border: var(--borde-fino) solid var(--color-borde);
  }
</style>
