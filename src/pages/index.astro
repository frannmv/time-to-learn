---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout>
  <main>
    <h1>TimeToLearn · TTL</h1>
    <p>Un sitio interactivo para ver lo que pasa dentro de una red, capa por capa.</p>
    <p class="estado">En construcción: el primer módulo llega en la Etapa 2.</p>
  </main>
</BaseLayout>

<style>
  main {
    min-block-size: 100vh;
    max-inline-size: var(--ancho-lectura);
    margin-inline: auto;
    padding: var(--margen-pagina);
    display: grid;
    place-content: center;
    gap: var(--espacio-4);
    text-align: center;
  }

  p {
    font-size: var(--texto-md);
  }

  .estado {
    color: var(--color-texto-atenuado);
    font-size: var(--texto-base);
  }
</style>
